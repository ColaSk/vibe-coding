# fastapi_scaffold
# 开关改为 true 后，第一次使用才会连接对应后端。
# 默认名字是 db、redis、kafka、rabbitmq。
# 同一种再加一条时用双下划线，例如 MYSQL__ANALYTICS__ENABLED=true。

MYSQL_ENABLED=false
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DB=app

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
