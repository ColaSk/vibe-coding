{
  "name": "cursor-switch-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "cursor-switch desktop client",
  "author": "cursor-switch",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "npm run desktop",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "start": "npm run desktop",
    "desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "web": "vite",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@iconify/react": "^6.0.4",
    "echarts": "^6.1.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sass": "^1.102.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  }
}
